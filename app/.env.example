# API URL (backend). Leer = relative /api-Aufrufe über den Vite-Proxy,
# funktioniert dann auch vom Handy im WLAN (http://<mac-ip>:5173)
VITE_API_URL=

# Ziel des Vite-Proxys im Dev-Modus
VITE_API_PROXY=http://localhost:3000

# Base URL for GitHub Pages (e.g., /schompf-0/ or / for custom domain)
VITE_BASE_URL=/
